{
  "manifest_version": 3,
  "name": "Slipstream Browser Companion",
  "short_name": "Slipstream",
  "version": "0.2.1",
  "description": "Reports bounded regional-denial and incomplete-navigation evidence to Slipstream.",
  "key": "",
  "minimum_chrome_version": "102",
  "permissions": [
    "nativeMessaging",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "detector.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
