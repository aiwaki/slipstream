{
  "name": "slipstream-tray",
  "version": "0.1.9-preview.23",
  "private": true,
  "description": "Slipstream menu-bar tray (Tauri v2)",
  "scripts": {
    "sync-version": "python3 ../scripts/sync_version.py",
    "build:daemon": "../scripts/build_and_stage_daemon.sh",
    "tauri": "tauri",
    "dev": "npm run sync-version && tauri dev",
    "build": "npm run build:release",
    "verify:bundle:local": "python3 ../scripts/verify_macos_app_bundle.py --app-bundle src-tauri/target/release/bundle/macos/Slipstream.app --fresh-daemon ../spike/dist/slipstreamd/slipstreamd --staged-daemon src-tauri/slipstreamd/slipstreamd",
    "verify:bundle:release": "python3 ../scripts/verify_macos_app_bundle.py --app-bundle src-tauri/target/aarch64-apple-darwin/release/bundle/macos/Slipstream.app --fresh-daemon ../spike/dist/slipstreamd/slipstreamd --staged-daemon src-tauri/slipstreamd/slipstreamd",
    "verify:local-install": "npm run verify:bundle:local -- --installed-app /Applications/Slipstream.app",
    "build:local": "npm run sync-version && tauri build --config src-tauri/tauri.local.conf.json && npm run verify:bundle:local",
    "build:release": "npm run sync-version && tauri build --target aarch64-apple-darwin && npm run verify:bundle:release"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
