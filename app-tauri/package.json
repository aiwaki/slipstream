{
  "name": "slipstream-tray",
  "version": "0.1.9-preview.23",
  "private": true,
  "description": "Slipstream menu-bar tray (Tauri v2)",
  "scripts": {
    "sync-version": "python3 ../scripts/sync_version.py",
    "build:daemon": "../scripts/build_and_stage_daemon.sh",
    "tauri": "tauri",
    "dev": "npm run sync-version && tauri dev",
    "build": "npm run build:release",
    "build:local": "npm run sync-version && npm run build:daemon && tauri build --config src-tauri/tauri.local.conf.json",
    "build:release": "npm run sync-version && npm run build:daemon && tauri build --target aarch64-apple-darwin"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
