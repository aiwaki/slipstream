{
  "schema_version": 1,
  "contract": "slipstream.pending-navigation-probe",
  "contract_version": 1,
  "scope": "composed_local_daemon_runtime",
  "bounds": {
    "capability_bits": 128,
    "capability_ttl_ms": 30000,
    "max_live_capabilities": 32,
    "max_capabilities_and_guards": 32,
    "min_pending_observation_ms": 8000,
    "max_correlated_downstream_bytes": 524288
  },
  "ipc": {
    "socket_path": "/var/run/slipstream-browser-probe.sock",
    "claim_lease_ms": 5000,
    "max_enqueue_age_ms": 14000,
    "max_request_bytes": 2048,
    "owner_only_mode": "0600",
    "request_fields": {
      "claim": [
        "schema_version",
        "operation",
        "launch_id"
      ],
      "submit": [
        "schema_version",
        "operation",
        "launch_id",
        "result"
      ]
    },
    "response_fields": [
      "schema_version",
      "accepted",
      "operation",
      "reason",
      "job"
    ],
    "runtime_composed": true
  },
  "worker_lifecycle": {
    "lazy": true,
    "max_concurrent_workers": 1,
    "one_aqua_launch_skips_stale_claims_before_live_job": true,
    "accepted_result_ends_launch_after_cleanup": true,
    "accepted_route_effect_resets_exact_client_stream": true,
    "bounded_partial_payload_jobs_first": true,
    "empty_queue_grace_ms": 15000,
    "startup_attestation_grace_ms": 200,
    "worker_runtime_budget_ms": 100000,
    "stale_claim_is_skipped_without_worker_failure": true,
    "launcher_timeout_ms": 120000,
    "retry_after_worker_loss_ms": 5000,
    "same_host_recursive_jobs": false,
    "accepted_result_guard_until_worker_cleanup": true,
    "claimed_job_guard_until_worker_cleanup": true,
    "ambiguous_cleanup_failure_retains_guard": true,
    "worker_cleanup_failure_retains_guard": true,
    "cleanup_releases_exact_launch_only": true,
    "unclaimed_rejected_result_guard_until_expiry": true,
    "unclaimed_live_capability_guard_until_expiry": true,
    "unstarted_job_guard_ms": 0,
    "unstarted_discard_uses_worker_lock": true,
    "submit_before_cleanup": true,
    "cleanup_before_worker_exit": true,
    "browser_observer_composed": true
  },
  "browser_surface": {
    "launchservices_hidden": true,
    "visible_window": false,
    "unified_headless": false,
    "sandbox_enabled": true,
    "private_profile": true,
    "extensions_disabled": true,
    "quic_disabled": true
  },
  "privacy": {
    "job_fields": [
      "schema_version",
      "capability",
      "host",
      "request_started_at_unix_ms",
      "issued_at_unix_ms",
      "expires_at_unix_ms"
    ],
    "result_fields": [
      "schema_version",
      "capability",
      "host",
      "request_started_at_unix_ms",
      "observed_at_unix_ms",
      "outcome"
    ],
    "forbidden_fields": [
      "url",
      "path",
      "query",
      "title",
      "text",
      "body",
      "cookies",
      "form_data",
      "browser_error",
      "request_id",
      "tab_id",
      "ip"
    ],
    "remote_transport": false
  },
  "job_defaults": {
    "schema_version": 1,
    "capability": "0123456789abcdef0123456789abcdef",
    "host": "example.net",
    "request_started_at_unix_ms": 1000000,
    "issued_at_unix_ms": 1010000,
    "expires_at_unix_ms": 1040000
  },
  "result_defaults": {
    "schema_version": 1,
    "capability": "0123456789abcdef0123456789abcdef",
    "host": "example.net",
    "request_started_at_unix_ms": 1000000,
    "observed_at_unix_ms": 1018001,
    "outcome": "navigation_pending"
  },
  "outcomes": {
    "route_effect": [
      "navigation_pending",
      "navigation_failed",
      "regional_access_denied",
      "edge_access_denied"
    ],
    "retry_same_route_without_route_effect": [
      "navigation_complete",
      "challenge_or_auth",
      "usable",
      "terminal_error"
    ]
  },
  "invariants": {
    "one_shot": true,
    "bound_to_exact_live_relay_object": true,
    "bound_to_host_request_start_and_stage": true,
    "relay_teardown_revokes_capability": true,
    "valid_capability_is_consumed_on_rejected_result": true,
    "response_headers_are_not_terminal_completion": true,
    "complete_observation_retries_same_route": true,
    "failed_observation_advances_after_bound_original_idle": true,
    "denial_observation_advances_only_disposable_fixture_stage": true,
    "challenge_auth_usable_terminal_never_learn_route": true,
    "disposable_fixture_jobs_exact_endpoint_only": true,
    "semantic_signal_v3_modified": false,
    "production_runtime_composition": true,
    "system_network_mutation": false,
    "external_geph_allowed": false,
    "discord_youtube_googlevideo_allowed": false
  },
  "remaining_gates": {
    "owner_only_job_result_ipc": "required",
    "lazy_worker_lifecycle": "required",
    "self_probe_loop_suppression": "required",
    "installed_package_and_update": "required",
    "exact_uninstall": "required",
    "idle_cost": "required",
    "clean_profile": "required",
    "original_navigation_end_to_end": "required"
  }
}
