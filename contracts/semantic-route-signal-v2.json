{
  "schema_version": 2,
  "contract": "slipstream.semantic-route-signal",
  "contract_version": 2,
  "limits": {
    "max_payload_bytes": 2048,
    "max_age_ms": 120000,
    "max_future_skew_ms": 5000,
    "cooldown_ms": 300000,
    "min_confidence_bps": 9000
  },
  "privacy": {
    "allowed_fields": [
      "schema_version",
      "signal_id",
      "source",
      "host",
      "category",
      "confidence_bps",
      "observed_at_unix_ms",
      "top_level"
    ],
    "forbidden_fields": [
      "url",
      "path",
      "query",
      "title",
      "text",
      "body",
      "cookies",
      "form_data",
      "browser_error"
    ]
  },
  "signal_defaults": {
    "schema_version": 2,
    "signal_id": "fedcba9876543210fedcba9876543210",
    "source": "browser_extension",
    "host": "example.net",
    "category": "incomplete_response",
    "confidence_bps": 10000,
    "observed_at_unix_ms": 1000000,
    "top_level": true
  },
  "context_defaults": {
    "now_unix_ms": 1050000,
    "route_class": "unknown",
    "owned_geph_payload_ready": true,
    "last_accepted_at_unix_ms": null,
    "signal_id_seen": false
  },
  "parser_vectors": [
    {
      "name": "missing-required-field",
      "remove": "top_level",
      "expected_error": "invalid_shape"
    },
    {
      "name": "privacy-expanding-browser-error-field",
      "add": {
        "browser_error": "net::ERR_CONTENT_LENGTH_MISMATCH"
      },
      "expected_error": "invalid_shape"
    },
    {
      "name": "v1-remains-a-separate-contract",
      "replace": {
        "schema_version": 1
      },
      "expected_error": "unsupported_version"
    },
    {
      "name": "regional-denial-remains-v1-only",
      "replace": {
        "category": "regional_access_denied"
      },
      "expected_error": "invalid_category"
    },
    {
      "name": "ip-literal-is-not-a-hostname",
      "replace": {
        "host": "127.0.0.1"
      },
      "expected_error": "invalid_host"
    },
    {
      "name": "invalid-confidence",
      "replace": {
        "confidence_bps": 10001
      },
      "expected_error": "invalid_confidence"
    }
  ],
  "vectors": [
    {
      "name": "eligible-unknown-host-requires-independent-complete-response",
      "signal": {
        "host": "Example.NET."
      },
      "expected": {
        "accepted": true,
        "action": "confirm_exact_host_geo_exit",
        "reason": "accepted",
        "host": "example.net"
      }
    },
    {
      "name": "subframe-signal-is-rejected",
      "signal": {
        "top_level": false
      },
      "expected": {
        "accepted": false,
        "action": "none",
        "reason": "not_top_level",
        "host": "example.net"
      }
    },
    {
      "name": "replayed-signal-is-rejected",
      "context": {
        "signal_id_seen": true
      },
      "expected": {
        "accepted": false,
        "action": "none",
        "reason": "replay",
        "host": "example.net"
      }
    },
    {
      "name": "local-bypass-route-is-protected",
      "signal": {
        "host": "gateway.discord.gg"
      },
      "context": {
        "route_class": "local_bypass"
      },
      "expected": {
        "accepted": false,
        "action": "none",
        "reason": "protected_route",
        "host": "gateway.discord.gg"
      }
    },
    {
      "name": "direct-route-is-protected",
      "signal": {
        "host": "www.google.com"
      },
      "context": {
        "route_class": "direct_passthrough"
      },
      "expected": {
        "accepted": false,
        "action": "none",
        "reason": "protected_route",
        "host": "www.google.com"
      }
    },
    {
      "name": "existing-geo-exit-needs-no-overlay",
      "signal": {
        "host": "chatgpt.com"
      },
      "context": {
        "route_class": "geo_exit"
      },
      "expected": {
        "accepted": false,
        "action": "none",
        "reason": "already_geo_exit",
        "host": "chatgpt.com"
      }
    },
    {
      "name": "owned-backend-is-required",
      "context": {
        "owned_geph_payload_ready": false
      },
      "expected": {
        "accepted": false,
        "action": "none",
        "reason": "backend_unavailable",
        "host": "example.net"
      }
    }
  ]
}
